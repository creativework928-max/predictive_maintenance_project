# ============================================================
# Predictive Maintenance Project
# .gitignore
# ============================================================


# ------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
.directory
.Trash-*


# ------------------------------------------------------------
# Python bytecode / caches
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.pyo
*.pyd

# Python cache directories
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover


# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Common virtual-environment names
.python-version
.python-version.local


# ------------------------------------------------------------
# Packaging / build artifacts
# ------------------------------------------------------------

build/
dist/
*.egg-info/
*.egg
.eggs/

pip-wheel-metadata/
MANIFEST
*.manifest
*.spec


# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------

.ipynb_checkpoints/

# Jupyter temporary/runtime files
.jupyter_cache/

# Do not ignore notebooks themselves.
# The project notebook should remain version controlled:
#
# notebooks/task_2_feature_engineering.ipynb


# ------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------

# Visual Studio Code
.vscode/

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
.#*
\#*\#

# Visual Studio
.vs/


# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets
secrets/
credentials/
credentials.json

# Cloud / API credentials
.aws/
.gcloud/
.azure/

# Service-account credentials
service-account*.json
*-service-account*.json


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/
log/
*.out


# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.old

tmp/
temp/
cache/

# OS/editor temporary files
*.orig
*.rej


# ------------------------------------------------------------
# Project-generated reports
# ------------------------------------------------------------

# Generated visualizations
reports/figures/

# Generated HTML reports
reports/*.html

# Generated DOCX reports
reports/*.docx

# Generated PDF reports, if added later
reports/*.pdf

# Generated report data/intermediate artifacts
reports/generated/
reports/tmp/

# Keep report directory structure available through .gitkeep
# when desired.


# ------------------------------------------------------------
# Generated execution metadata
# ------------------------------------------------------------

reports/task2_execution_summary.json
reports/*.json

# If experiment metadata is generated elsewhere
artifacts/
outputs/
results/


# ------------------------------------------------------------
# Processed datasets
# ------------------------------------------------------------

# Processed/engineered data is generated by the pipeline.
data/processed/

# Keep the directory structure in Git if desired:
# data/processed/.gitkeep


# ------------------------------------------------------------
# Raw datasets
# ------------------------------------------------------------

# Ignore downloaded/raw datasets by default.
#
# This prevents accidentally committing large datasets or
# externally sourced data.
data/raw/*

# Keep the raw-data directory itself available.
!data/raw/.gitkeep

# Explicitly ignore common dataset formats
data/raw/*.csv
data/raw/*.tsv
data/raw/*.parquet
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
data/raw/*.zip
data/raw/*.gz


# ------------------------------------------------------------
# Large data / ML artifacts
# ------------------------------------------------------------

*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# Model files
*.pt
*.pth
*.ckpt
*.onnx
*.keras
*.h5

# Serialized pipelines
*.model
*.bin


# ------------------------------------------------------------
# Database files
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3

*.db-journal
*.sqlite-journal


# ------------------------------------------------------------
# Machine-learning experiment tracking
# ------------------------------------------------------------

mlruns/
wandb/
.neptune/
.tensorboard/
runs/

# Common experiment output directories
checkpoints/
models/
model_artifacts/


# ------------------------------------------------------------
# Profiling / performance output
# ------------------------------------------------------------

*.prof
*.lprof
.prof/
profile/
profiling/


# ------------------------------------------------------------
# Documentation build artifacts
# ------------------------------------------------------------

_site/
site/
docs/_build/
docs/.cache/

# Sphinx
*.doctree
*.buildinfo


# ------------------------------------------------------------
# Test artifacts
# ------------------------------------------------------------

.pytest_cache/
.tox/
.nox/

# Test reports
test-results/
test-reports/

# Coverage reports
coverage/
htmlcov/


# ------------------------------------------------------------
# Code quality tool caches
# ------------------------------------------------------------

.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# Black cache
.black_cache/


# ------------------------------------------------------------
# Local configuration
# ------------------------------------------------------------

config.local.py
local_config.py
settings.local.py

# Local development overrides
*.local


# ------------------------------------------------------------
# Notebook-generated exports
# ------------------------------------------------------------

# Notebook-generated HTML/PDF exports
notebooks/*.html
notebooks/*.pdf

# Notebook temporary outputs
notebooks/.cache/


# ------------------------------------------------------------
# Data-science temporary files
# ------------------------------------------------------------

*.csv.tmp
*.csv.bak
*.json.tmp
*.json.bak

# Generic generated files
generated/
generated_data/
generated_features/


# ------------------------------------------------------------
# Operating / deployment artifacts
# ------------------------------------------------------------

*.pid
*.pid.lock

docker-compose.override.yml

# Local Docker volumes
.docker/


# ------------------------------------------------------------
# Node / frontend artifacts
# ------------------------------------------------------------
# Included defensively in case a future dashboard/frontend is added.

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/


# ------------------------------------------------------------
# Documentation tooling
# ------------------------------------------------------------

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz


# ------------------------------------------------------------
# Local project state
# ------------------------------------------------------------

.project_state/
.task_state/
.local_state/

# Lock files created by some local tooling should normally
# remain tracked when they define reproducible dependencies.
# Therefore package/dependency lock files are intentionally
# NOT ignored here.


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# SSH keys accidentally placed in the project
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub


# ------------------------------------------------------------
# Optional: keep important directory placeholders
# ------------------------------------------------------------

# These files can be committed to preserve otherwise-empty
# directories.

# !data/raw/.gitkeep
# !data/processed/.gitkeep
# !reports/figures/.gitkeep